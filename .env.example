# Copy to .env (the start scripts do this for you) and adjust as needed.

# SQLite file, relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Session signing key, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Outgoing mail for verification codes. Leave SMTP_HOST empty to print
# messages to the server console instead.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

# Set to 1 to run as a public demo with throwaway sandbox accounts
DEMO_MODE=""
